 "flows": [
  {
   "name": "用户打开一个列表页",
   "steps": [
    "web: 路由守卫，TabOutlet 挂载页面",
    "platform_pages: 列表页按 URL 里的筛选发起查询",
    "platform_shell: 请求客户端带 JWT 调 /api/v1",
    "http_api: JWT 中间件 + 路由 + 权限码校验",
    "services: 业务逻辑",
    "data: CRUD，按数据范围过滤",
    "数据库: 查询"
   ]
  },
  {
   "name": "AI 助手调用写操作工具",
   "steps": [
    "platform_pages: AI 对话流式请求",
    "http_api: 鉴权并转给插件路由",
    "plugins: ai 插件编排对话",
    "LLM API: 模型决定调用哪个工具",
    "plugins: 写操作先出预览，等本人在网页确认",
    "services: 按确认人的数据范围执行",
    "数据库: 落库"
   ]
  },
  {
   "name": "外部系统增量同步（开放接口）",
   "steps": [
    "plugins: 网关验签 → nonce → scope → 限流",
    "plugins: 按（变更时间，id）游标取一页",
    "数据库: COALESCE(updated_time, created_time) 游标查询",
    "plugins: 写调用日志"
   ]
  }
 ],
