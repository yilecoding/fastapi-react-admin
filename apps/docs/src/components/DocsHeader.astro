---
import HomeHeader from './HomeHeader.astro'
import LanguageSelect from './LangSelect.astro'
import Search from '@astrojs/starlight/components/Search.astro'
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro'
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro'
import ThemeSelect from './ThemeSelect.astro'

const { hasSidebar, sidebar, locale } = Astro.locals.starlightRoute
const sections = sidebar.filter((entry) => entry.type === 'group')
const label = locale === 'en' ? 'Documentation sections' : '文档分类'
---

{!hasSidebar ? <HomeHeader /> : (
  <div class="docs-header">
    <div class="docs-brand"><SiteTitle /></div>
    <fra-doc-sections class="docs-sections print:hidden">
      <nav aria-label={label}>
        {sections.map((section) => {
          const first = section.entries.find((entry) => entry.type === 'link')
          const current = section.entries.some((entry) => entry.type === 'link' && entry.isCurrent)
          return first?.type === 'link' && (
            <a href={first.href} aria-current={current ? 'true' : undefined}>{section.label}</a>
          )
        })}
      </nav>
    </fra-doc-sections>
    <div class="docs-tools print:hidden">
      <Search />
      <div class="docs-preferences"><SocialIcons /><ThemeSelect /><LanguageSelect /></div>
    </div>
    <!-- 阅读进度线：样式和首页胶囊那条是同一份（HomeHeader.astro 的全局样式），这里贴在通栏顶栏的底边 -->
    <i class="scroll-progress" aria-hidden="true"></i>
  </div>
)}

<script>
  class DocSections extends HTMLElement {
    connectedCallback() {
      const nav = this.querySelector('nav')
      const current = this.querySelector<HTMLElement>('[aria-current]')
      if (nav && current) {
        nav.scrollLeft = Math.max(0, current.offsetLeft - nav.offsetLeft - (nav.clientWidth - current.offsetWidth) / 2)
      }
    }
  }
  customElements.define('fra-doc-sections', DocSections)
</script>

<style>
  .docs-header {
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: 4rem 3rem;
    align-items: center;
    column-gap: 1.5rem;
  }
  .docs-brand { min-width: 0 }
  .docs-brand :global(.site-title) { font-size: 1.05rem; gap: 0.6rem; letter-spacing: -0.035em }
  .docs-brand :global(img) { width: 1.9rem; height: 1.9rem }
  .docs-brand :global(span) { text-overflow: ellipsis }
  .docs-sections { grid-row: 2; grid-column: 1 / -1; min-width: 0; height: 100% }
  nav { display: flex; align-items: stretch; gap: 1.65rem; height: 100%; overflow-x: auto; scrollbar-width: none }
  nav::-webkit-scrollbar { display: none }
  nav a {
    position: relative; display: flex; align-items: center; flex-shrink: 0;
    padding: 0 0.1rem; color: var(--sl-color-gray-3);
    font-size: 0.875rem; font-weight: 500; text-decoration: none; white-space: nowrap;
  }
  nav a:hover { color: var(--sl-color-white) }
  nav a[aria-current] { color: var(--sl-color-white); font-weight: 650 }
  nav a[aria-current]::after {
    content: ''; position: absolute; inset-inline: 0; bottom: 0;
    height: 2px; border-radius: 2px; background: var(--sl-color-accent);
  }
  nav a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: -4px; border-radius: 4px }
  .docs-tools, .docs-preferences { display: flex; gap: 0.85rem; align-items: center }
  .docs-tools { grid-row: 1; grid-column: 2 }
  .docs-preferences { display: none }
  @media (min-width: 50rem) {
    .docs-preferences { display: flex }
    .docs-tools :global(button[data-open-modal]) { width: 11rem; max-width: none }
  }
  @media (min-width: 80rem) {
    .docs-header { grid-template-columns: auto minmax(0, 1fr) auto; grid-template-rows: 1fr; gap: 2rem }
    .docs-sections { grid-row: 1; grid-column: 2 }
    .docs-tools { grid-column: 3 }
    nav { gap: 1.4rem }
    .docs-tools :global(button[data-open-modal]) { width: 9rem }
  }
  @media (max-width: 49.99rem) {
    .docs-tools { padding-inline-end: calc(var(--sl-menu-button-size) + 0.5rem) }
    .docs-header { column-gap: 0.5rem }
    .docs-brand :global(.site-title) { font-size: 0.95rem }
    nav { gap: 1rem }
    nav a { font-size: 0.8125rem }
  }
</style>

<style is:global>
  :root[data-has-sidebar] { --sl-nav-height: 7rem }
  :root[data-has-sidebar] header.header { padding-block: 0; padding-inline-end: var(--sl-nav-pad-x) }
  :root[data-has-sidebar] .sl-menu-button { top: calc((4rem - var(--sl-menu-button-size)) / 2) }
  @media (min-width: 80rem) {
    :root[data-has-sidebar] { --sl-nav-height: 4.5rem }
  }
</style>
