---
/**
 * 语言切换：覆盖 Starlight 的 `LanguageSelect`（原版是一个原生 `<select>`，见 Dropdown.astro 开头）。
 * 每个选项是指向「同一页的另一种语言」的真链接，点的时候把当前的 `#锚点` 带过去。
 */
import config from 'virtual:starlight/user-config'
import Dropdown from './Dropdown.astro'

const { locale } = Astro.locals.starlightRoute // 根语言（中文）是 undefined
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
// 当前页去掉 base 和语言前缀之后的那一截，比如 `/features/rbac/`
let rest = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname
if (locale) rest = rest.replace(new RegExp(`^/${locale}(?=/|$)`), '')
if (!rest.startsWith('/')) rest = `/${rest}`

const options = Object.entries(config.locales ?? {}).map(([code, item]) => ({
  label: item!.label,
  lang: item!.lang,
  href: `${base}${code === 'root' ? '' : `/${code}`}${rest}`,
  current: code === 'root' ? !locale : code === locale,
}))
const current = options.find((o) => o.current)
---

{options.length > 1 && (
  <Dropdown label={Astro.locals.t('languageSelect.accessibleLabel')} class="lang-select">
    <Fragment slot="trigger">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="lang-icon"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.500 5.700 12 3z" /></svg>
      <span>{current?.label}</span>
    </Fragment>
    {options.map((o) => (
      <a class="dd-item" href={o.href} lang={o.lang} hreflang={o.lang} aria-current={o.current ? 'true' : undefined} data-lang-link>
        <span>{o.label}</span>
        {o.current && <svg class="dd-end" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>}
      </a>
    ))}
  </Dropdown>
)}

<script>
  // 静态页面不知道访客停在哪个小标题上：点的那一刻把 #锚点 接到目标地址后面
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-lang-link]')
    if (link && location.hash && !link.hash) link.hash = location.hash
  })
</script>

<style>
  .lang-icon { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round }
</style>
