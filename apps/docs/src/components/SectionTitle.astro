---
/**
 * 首页每一节的标题：左对齐的大标题 + 一句引言（slot），右边可选一个「看文档 →」。
 * 不要眉标、不要居中 —— 跟正文同一条左边线，读起来像文档而不是广告。
 */
interface Props {
  id: string
  title: string
  more?: string
  href?: string
}
const { id, title, more, href } = Astro.props
---

<header class="section-title not-content">
  <div class="section-title-main">
    <h2 id={id}>{title}</h2>
    {Astro.slots.has('default') && <div class="section-lead"><slot /></div>}
  </div>
  {more && href && <a class="section-more" href={href}>{more} <span aria-hidden="true">→</span></a>}
</header>

<style is:global>
  .section-title {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem;
    margin: 7.5rem 0 2.25rem !important;
  }
  :root[data-has-hero] .sl-markdown-content > .section-title:first-child { margin-top: clamp(1.5rem, 4vw, 3rem) !important }
  .section-title > * { margin: 0 }
  .section-title-main { max-width: 46rem }
  .section-title-main > * { margin: 0 }
  .section-title h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.2; font-weight: 750; letter-spacing: -0.03em; color: var(--sl-color-white) }
  .section-lead { margin-top: 0.75rem !important; font-size: 1rem; line-height: 1.75; color: var(--sl-color-gray-3) }
  .section-lead p { margin: 0 }
  .section-more { font-size: 0.9rem; font-weight: 500; color: var(--sl-color-gray-3); text-decoration: none; white-space: nowrap }
  .section-more:hover { color: var(--brand) }
</style>
