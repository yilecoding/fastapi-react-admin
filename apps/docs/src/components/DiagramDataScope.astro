---
interface Role { name: string; summary: string }
interface Props {
  roles: [Role, Role, Role]
  controls: string
  heading: string
  columns: [string, string, string]
  people: [string, string, string, string]
  departments: [string, string, string, string]
  regions: [string, string]
  visible: string
  excluded: string
  caption: string
}
const { roles, controls, heading, columns, people, departments, regions, visible, excluded, caption } = Astro.props
const keys = ['all', 'east', 'south']
const regionKeys = ['east', 'east', 'south', 'south']
---

<scope-scene class="scope-scene" data-scope="east">
  <div class="scene-switch" role="group" aria-label={controls}>
    {roles.map((role, i) => <button type="button" data-role={keys[i]} aria-pressed={i === 1}>{role.name}</button>)}
  </div>
  <div class="scope-map" aria-hidden="true">
    <div class="scope-source"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3 4 6v6c0 4 8 9 8 9s8-5 8-9V6z"/><path d="m8 12 3 3 5-6"/></svg><code>data_scope</code></div>
    <div class="scope-branches"><span data-region="east">{regions[0]}<b>↙ ↘</b></span><span data-region="south">{regions[1]}<b>↙ ↘</b></span></div>
  </div>
  <div class="scope-table">
    <div class="scope-table-title"><span>{heading}</span><code>sys_user</code></div>
    <table>
      <thead><tr>{columns.map(col => <th scope="col">{col}</th>)}</tr></thead>
      <tbody>{people.map((person, i) => (
        <tr data-row-region={regionKeys[i]} data-allowed={i < 2} aria-label={i < 2 ? undefined : excluded}>
          <td><span class="scope-person"><i aria-hidden="true">{person.slice(0,1)}</i><span>{person}</span></span><span class="scope-redacted" aria-hidden="true">••••••</span></td>
          <td><span class="scope-department">{departments[i]}</span><span class="scope-redacted" aria-hidden="true">••••</span></td>
          <td><span class="scope-state">{visible}</span><span class="scope-lock" aria-hidden="true">—</span></td>
        </tr>
      ))}</tbody>
    </table>
    <div class="scope-result" aria-live="polite" aria-atomic="true">{roles.map((role, i) => <span data-summary={keys[i]} hidden={i !== 1}>{role.summary}</span>)}</div>
  </div>
  <p class="scene-caption"><span>{caption}</span><code>WHERE dept_id IN (…)</code></p>
</scope-scene>

<script>
  class ScopeScene extends HTMLElement {
    connectedCallback() {
      const excluded = this.querySelector('[data-allowed="false"]')?.getAttribute('aria-label') || ''
      this.querySelectorAll<HTMLButtonElement>('[data-role]').forEach(button => {
        button.addEventListener('click', () => {
          const selected = button.dataset.role!
          this.dataset.scope = selected
          this.querySelectorAll<HTMLButtonElement>('[data-role]').forEach(item => item.setAttribute('aria-pressed', String(item === button)))
          this.querySelectorAll<HTMLElement>('[data-summary]').forEach(item => { item.hidden = item.dataset.summary !== selected })
          this.querySelectorAll<HTMLElement>('[data-row-region]').forEach(row => {
            const allowed = selected === 'all' || row.dataset.rowRegion === selected
            row.dataset.allowed = String(allowed)
            if (allowed) row.removeAttribute('aria-label')
            else row.setAttribute('aria-label', excluded)
          })
        })
      })
    }
  }
  if (!customElements.get('scope-scene')) customElements.define('scope-scene', ScopeScene)
</script>

<style>
  .scope-scene { display: block }
  .scene-switch { gap: .1rem }
  .scene-switch button { font-size: .7rem; padding: .5rem .6rem }
  .scope-map { padding: 1.1rem 2rem .6rem; position: relative }
  .scope-source { display: flex; align-items: center; justify-content: center; gap: .5rem; color: var(--brand) }
  .scope-source svg { width: 1.7rem; height: 1.7rem; stroke: currentColor; stroke-width: 1.3 }
  .scope-source code { font-size: .7rem; font-family: var(--__sl-font-mono) }
  .scope-branches { display: flex; justify-content: space-around; position: relative; margin-top: 1.3rem }
  .scope-branches::before { content: ''; position: absolute; width: 52%; top: -.75rem; left: 24%; height: .75rem; border: 1px solid var(--line-strong); border-bottom: 0; border-radius: .5rem .5rem 0 0 }
  .scope-branches::after { content: ''; position: absolute; width: 1px; height: .6rem; top: -1.3rem; left: 50%; background: var(--brand) }
  .scope-branches span { text-align: center; font-size: .7rem; color: var(--sl-color-gray-3); transition: color .2s }
  .scope-branches b { display: block; font-size: .8rem; letter-spacing: .9rem; font-weight: 400; padding-left: .9rem; color: var(--line-strong); line-height: 2 }
  [data-scope='east'] [data-region='east'], [data-scope='south'] [data-region='south'], [data-scope='all'] [data-region] { color: var(--brand) }
  [data-scope='east'] [data-region='east'] b, [data-scope='south'] [data-region='south'] b, [data-scope='all'] [data-region] b { color: var(--brand) }
  .scope-table { border: 1px solid var(--line-strong); border-radius: .8rem; background: var(--scene-paper); overflow: hidden; box-shadow: 0 14px 35px -22px color-mix(in oklab, var(--brand) 30%, transparent) }
  .scope-table-title { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .75rem 1rem; border-bottom: 1px solid var(--line); font-size: .8rem; font-weight: 600; color: var(--sl-color-white) }
  .scope-table-title code { color: var(--sl-color-gray-3); font-family: var(--__sl-font-mono); font-size: .6rem; font-weight: 400 }
  table { width: 100%; border-collapse: collapse; font-size: .7rem; table-layout: fixed }
  th { text-align: left; font-weight: 400; color: var(--sl-color-gray-3); padding: .55rem 1rem; background: var(--scene-mist) }
  th:first-child { width: 42% }
  th:last-child { width: 25% }
  td { padding: .65rem 1rem; border-bottom: 1px solid var(--line); height: 3.2rem; color: var(--sl-color-gray-2) }
  .scope-person { display: flex; align-items: center; gap: .55rem }
  .scope-person i { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; flex-shrink: 0; border-radius: .45rem; font-style: normal; font-size: .65rem; background: var(--diagram-hl-bg); color: var(--brand) }
  .scope-state { display: inline-flex; align-items: center; gap: .4rem; color: var(--brand); font-size: .65rem }
  .scope-state::before { content: ''; width: .3rem; height: .3rem; border-radius: 50%; background: currentColor }
  .scope-redacted, .scope-lock { display: none; color: var(--sl-color-gray-4); letter-spacing: .12em }
  [data-allowed='false'] { background: repeating-linear-gradient(-45deg, transparent, transparent 4px, var(--line) 5px, transparent 6px) }
  [data-allowed='false'] :is(.scope-person, .scope-department, .scope-state) { display: none }
  [data-allowed='false'] :is(.scope-redacted, .scope-lock) { display: inline }
  .scope-result { padding: .7rem 1rem; color: var(--brand); font-size: .68rem; background: var(--diagram-hl-bg); min-height: 2.5rem }
  .scene-caption code { font-family: var(--__sl-font-mono); font-size: .6rem; white-space: nowrap }
  @media (max-width: 25rem) { td, th { padding-inline: .65rem } .scene-caption { flex-wrap: wrap; gap: .25rem } }
</style>
