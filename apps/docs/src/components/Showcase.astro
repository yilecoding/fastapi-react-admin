---
/** Homepage feature scene. Editorial copy comes from the localized MDX pages. */
interface Props {
  title: string
  lead: string
  href: string
  more: string
  eyebrow: string
  wide?: boolean
}
const { title, lead, href, more, eyebrow, wide = false } = Astro.props
---

<article class:list={['showcase not-content', { 'showcase--wide': wide }]}>
  <div class="showcase-copy">
    <span class="showcase-eyebrow">{eyebrow}</span>
    <h3>{title.split('\n').map(line => <span>{line}</span>)}</h3>
    <p class="showcase-lead">{lead}</p>
    {Astro.slots.has('default') && <div class="showcase-points"><slot /></div>}
    <a class="showcase-more" href={href}>{more}<span aria-hidden="true">↗</span></a>
  </div>
  <div class="showcase-diagram"><slot name="diagram" /></div>
</article>

<style is:global>
  .showcases {
    --scene-paper: var(--sl-color-black);
    --scene-mist: color-mix(in oklab, var(--brand) 5%, var(--sl-color-black));
    --scene-green: #7fe0bb;
    display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 56rem) { .showcases { grid-template-columns: repeat(2, minmax(0, 1fr)) } }
  .showcases > * { margin: 0 !important }
  .showcase {
    position: relative; min-width: 0; display: flex; flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2.25rem); gap: 2rem; overflow: hidden;
    border: 1px solid var(--line-strong); border-radius: 1.5rem;
    background: var(--scene-mist);
  }
  .showcase--wide { grid-column: 1 / -1; background: var(--scene-paper) }
  @media (min-width: 56rem) {
    .showcase--wide { gap: 2rem }
    .showcase--wide .showcase-copy { display: grid; grid-template-columns: 1.1fr 1fr; grid-template-areas: 'eyebrow lead' 'title lead' 'more points'; column-gap: 4rem; align-items: start }
    .showcase--wide .showcase-eyebrow { grid-area: eyebrow }
    .showcase--wide h3 { grid-area: title }
    .showcase--wide .showcase-lead { grid-area: lead; margin-top: .2rem !important }
    .showcase--wide .showcase-points { grid-area: points; margin-top: .5rem }
    .showcase--wide .showcase-more { grid-area: more; margin-top: 1rem !important }
  }
  .showcase-copy { display: flex; flex-direction: column; align-items: flex-start; min-width: 0 }
  .showcase-copy > * { margin: 0 }
  .showcase-eyebrow {
    display: flex; align-items: center; gap: .55rem; margin-bottom: 1rem;
    font-family: var(--__sl-font-mono); font-size: .68rem; font-weight: 500;
    letter-spacing: .06em; color: var(--brand);
  }
  .showcase-eyebrow::before { content: ''; width: .42rem; height: .42rem; background: currentColor; border-radius: 2px }
  .showcase h3 { font-size: 1.7rem; line-height: 1.3; font-weight: 730; letter-spacing: -.045em; color: var(--sl-color-white); text-wrap: balance }
  .showcase h3 > span { display: block }
  @media (min-width: 56rem) { .showcase--wide h3 { font-size: clamp(1.8rem, 2.5vw, 2.35rem) } }
  .showcase-lead { margin-top: .9rem !important; font-size: .94rem; line-height: 1.8; color: var(--sl-color-gray-2); max-width: 36em }
  .showcase-points { margin-top: 1rem; font-size: .8rem; line-height: 1.8; color: var(--sl-color-gray-3) }
  .showcase-points p { margin: 0 }
  .showcase-more { display: inline-flex; gap: 1rem; align-items: center; margin-top: 1.5rem !important; font-size: .84rem; font-weight: 600; color: var(--sl-color-white); text-decoration: none }
  .showcase-more span { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--brand); transition: background .2s, transform .2s }
  .showcase-more:hover span { background: var(--diagram-hl-bg); transform: translate(2px, -2px) }
  .showcase-diagram { min-width: 0 }
  .showcases :not(pre) > code:not([data-package]) { background: transparent; border: 0; padding: 0; border-radius: 0 }
  .showcases button { font-family: inherit; cursor: pointer; min-height: 2.75rem }
  .showcases :is(button, a):focus-visible { outline: 2px solid var(--brand); outline-offset: 5px }
  .scene-switch { display: flex; flex-wrap: wrap; gap: .35rem }
  .scene-switch button { border: 1px solid transparent; border-radius: .5rem; background: transparent; color: var(--sl-color-gray-3); padding: .5rem .7rem; font-size: .75rem; transition: color .2s, background .2s, border-color .2s }
  .scene-switch button:hover { color: var(--sl-color-white) }
  .scene-switch button[aria-pressed='true'] { color: var(--brand); border-color: color-mix(in oklab, var(--brand) 28%, transparent); background: var(--diagram-hl-bg) }
  .scene-caption { display: flex; justify-content: space-between; gap: 1rem; margin: 1rem 0 0; color: var(--sl-color-gray-3); font-size: .68rem; line-height: 1.6 }
  @media (prefers-reduced-motion: reduce) { .showcases *, .showcases *::before, .showcases *::after { animation: none !important; transition: none !important } }
</style>
