---
/**
 * 覆盖 Starlight 的 ThemeSelect：一个图标按钮，点开是「浅色 / 深色 / 跟随系统」三项（和语言切换同一个 Dropdown）。
 *
 * 原来是太阳 / 月亮两段式，没有「跟随系统」这一项 —— 点过一次就固定住，再也回不到跟随系统。
 * 状态沿用 Starlight 自己的约定（localStorage `starlight-theme`、`<html data-theme>`），
 * 所以首屏防闪烁的那段内联脚本（ThemeProvider）照常生效；「跟随系统」就是把那个键删掉。
 * 按钮上的图标是**当前实际生效**的那一侧（跟随系统时也是太阳或月亮），菜单里打勾的是**选的那一项**。
 */
import Dropdown from './Dropdown.astro'

const en = Astro.locals.starlightRoute.locale === 'en'
const label = Astro.locals.t('themeSelect.accessibleLabel')
const options = [
  { value: 'light', text: Astro.locals.t('themeSelect.light'), icon: 'sun' },
  { value: 'dark', text: Astro.locals.t('themeSelect.dark'), icon: 'moon' },
  { value: 'auto', text: en ? 'System' : '跟随系统', icon: 'monitor' },
]
const ICONS: Record<string, string> = {
  sun: 'M12 8a4 4 0 1 0 0 8a4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
  moon: 'M20.500 14.300A8.500 8.500 0 0 1 9.700 3.500a8.500 8.500 0 1 0 10.800 10.800z',
  monitor: 'M3 4h18v12H3zM8 20h8M12 16v4',
}
---

<fra-theme-select>
  <Dropdown label={label} class="theme-select">
    <Fragment slot="trigger">
      <svg class="theme-icon theme-icon--light" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.sun} /></svg>
      <svg class="theme-icon theme-icon--dark" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.moon} /></svg>
    </Fragment>
    {options.map((o) => (
      <button type="button" class="dd-item" data-theme-value={o.value} aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[o.icon]} /></svg>
        <span>{o.text}</span>
        <svg class="dd-end theme-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
      </button>
    ))}
  </Dropdown>
</fra-theme-select>

<script>
  const KEY = 'starlight-theme'
  const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
  const stored = () => {
    try {
      const v = localStorage.getItem(KEY)
      return v === 'light' || v === 'dark' ? v : 'auto'
    } catch {
      return 'auto'
    }
  }
  const apply = (pref: string) => {
    document.documentElement.dataset.theme = pref === 'auto' ? system() : pref
    // 顶栏和手机菜单底部各有一个，一起更新
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-value]')) {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeValue === pref))
    }
  }
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (stored() === 'auto') apply('auto')
  })

  class FraThemeSelect extends HTMLElement {
    connectedCallback() {
      apply(stored())
      for (const btn of this.querySelectorAll<HTMLButtonElement>('[data-theme-value]')) {
        btn.addEventListener('click', () => {
          const value = btn.dataset.themeValue!
          try {
            if (value === 'auto') localStorage.removeItem(KEY)
            else localStorage.setItem(KEY, value)
          } catch {}
          apply(value)
        })
      }
    }
  }
  if (!customElements.get('fra-theme-select')) customElements.define('fra-theme-select', FraThemeSelect)
</script>

<style is:global>
  fra-theme-select { display: inline-flex }
  /* 只有图标的按钮：方的，不要右边那个小箭头 */
  .theme-select .dd-trigger { width: 2.25rem; padding: 0; justify-content: center }
  .theme-select .dd-caret { display: none }
  .theme-icon { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round }
  /* Starlight 的 :root 是深色，浅色挂在 data-theme='light' 上 */
  .theme-icon--light { display: none }
  :root[data-theme='light'] .theme-icon--light { display: block }
  :root[data-theme='light'] .theme-icon--dark { display: none }
  .theme-check { visibility: hidden }
  [data-theme-value][aria-pressed='true'] { color: var(--sl-color-accent-high); font-weight: 600 }
  [data-theme-value][aria-pressed='true'] .theme-check { visibility: visible }
</style>
