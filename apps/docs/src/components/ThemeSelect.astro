---
/**
 * 覆盖 Starlight 的 ThemeSelect：顶栏里那个「自动 ▾」下拉换成太阳 / 月亮两段式切换。
 *
 * 状态沿用 Starlight 自己的约定（localStorage `starlight-theme`、`<html data-theme>`），
 * 所以首屏防闪烁的那段内联脚本（ThemeProvider）照常生效。没选过时跟随系统（auto），
 * 高亮的是系统当前那一侧；点一下就固定成浅色或深色。
 */
const label = Astro.locals.t('themeSelect.accessibleLabel')
const light = Astro.locals.t('themeSelect.light')
const dark = Astro.locals.t('themeSelect.dark')
---

<fra-theme-toggle class="theme-toggle" role="group" aria-label={label}>
  <button type="button" data-value="light" aria-label={light} title={light}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>
  <button type="button" data-value="dark" aria-label={dark} title={dark}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8z" />
    </svg>
  </button>
</fra-theme-toggle>

<script>
  const KEY = 'starlight-theme'
  const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
  const stored = () => {
    try {
      const v = localStorage.getItem(KEY)
      return v === 'light' || v === 'dark' ? v : 'auto'
    } catch {
      return 'auto'
    }
  }
  const apply = (pref: string) => {
    const theme = pref === 'auto' ? system() : pref
    document.documentElement.dataset.theme = theme
    for (const btn of document.querySelectorAll<HTMLButtonElement>('fra-theme-toggle button')) {
      btn.setAttribute('aria-pressed', String(btn.dataset.value === theme))
    }
  }
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (stored() === 'auto') apply('auto')
  })

  class FraThemeToggle extends HTMLElement {
    connectedCallback() {
      apply(stored())
      for (const btn of this.querySelectorAll<HTMLButtonElement>('button')) {
        btn.addEventListener('click', () => {
          const value = btn.dataset.value!
          try { localStorage.setItem(KEY, value) } catch {}
          apply(value)
        })
      }
    }
  }
  customElements.define('fra-theme-toggle', FraThemeToggle)
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--sl-color-gray-5);
  }
  button {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    color: var(--sl-color-gray-3);
    background: transparent;
    transition: background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }
  button:hover { color: var(--sl-color-white) }
  button[aria-pressed='true'] {
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.25), 0 0 0 1px var(--sl-color-gray-5);
  }
  svg { width: 1rem; height: 1rem }
</style>
