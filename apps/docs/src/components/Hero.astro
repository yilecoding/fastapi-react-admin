---
/**
 * 覆盖 Starlight 的 Hero（只在带 `hero` frontmatter 的页面出现 —— 也就是中英两个首页）。
 *
 * 版式走「克制」路线：不套面板、不铺渐变，白底 + 大留白，左边文案、右边立体榫卯，
 * 榫卯后面是几圈发丝细的同心圆。按钮是一种墨色，技术栈是带色点的小标签。
 * 文案全部来自页面 frontmatter（`hero` 是 Starlight 自带的，`landing` 是 content.config.ts
 * 里扩出来的），组件里不写任何一句给人看的话 —— 中英文各管各的 frontmatter。
 */
import { Icon } from '@astrojs/starlight/components'
import TenonStage from './TenonStage.astro'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero ?? {}
const { chips = [] } = data.landing ?? {}
// 技术栈标签的色点，按顺序取；颜色不是给人读的文字，放组件里
const DOTS = ['oklch(0.62 0.13 175)', 'oklch(0.66 0.13 220)', 'oklch(0.55 0.17 262)', 'oklch(0.58 0.16 300)']
---

<section class="hero not-content" data-tenon-tilt>
  <svg class="hero-rings" viewBox="0 0 800 800" aria-hidden="true">
    {[120, 200, 290, 390].map((r) => <circle cx="400" cy="400" r={r} />)}
    <!-- 一圈慢慢转的刻度，和两颗沿着圆走的光点：画面里除了榫卯之外唯一在动的东西 -->
    <circle class="hero-ring-ticks" cx="400" cy="400" r="245" />
    <g class="hero-orbit"><circle cx="600" cy="400" r="3" /></g>
    <g class="hero-orbit hero-orbit--far"><circle cx="400" cy="10" r="2.5" /></g>
  </svg>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow-soft" aria-hidden="true"></div>

  <div class="hero-copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="hero-tagline" set:html={tagline} />}
    {
      chips.length > 0 && (
        <ul class="hero-stack">
          {chips.map((c, i) => (
            <li style={`--dot: ${DOTS[i % DOTS.length]}`}>{c}</li>
          ))}
        </ul>
      )
    }
    {
      actions.length > 0 && (
        <div class="hero-actions">
          {actions.map(({ attrs: { class: cls, ...attrs } = {}, icon, link, text, variant }) => (
            <a class:list={['hero-btn', `hero-btn--${variant}`, cls]} href={link} {...attrs}>
              {text}
              {icon?.name && <Icon name={icon.name} size="1.05em" />}
              {icon?.html && <Fragment set:html={icon.html} />}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="hero-stage"><TenonStage /></div>
</section>

<style is:global>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.5rem;
    padding: clamp(2.5rem, 7vw, 6rem) 0 clamp(2rem, 5vw, 4rem);
  }
  @media (min-width: 60rem) {
    .hero { grid-template-columns: 1.1fr 0.9fr; column-gap: 2rem; align-items: center; min-height: 34rem }
  }

  /* 同心圆：圆心落在榫卯上，线细到几乎看不见，只给画面一点纵深 */
  .hero-rings {
    position: absolute; z-index: -1; pointer-events: none;
    top: 50%; right: -16rem; width: 52rem; height: 52rem; transform: translateY(-50%);
    fill: none; stroke: var(--ring); stroke-width: 1;
  }
  .hero-ring-ticks { stroke: var(--ring-strong); stroke-width: 6; stroke-dasharray: 1 15; transform-origin: 400px 400px; animation: hero-spin 160s linear infinite }
  .hero-orbit { transform-origin: 400px 400px; animation: hero-spin 26s linear infinite }
  .hero-orbit--far { animation-duration: 58s; animation-direction: reverse }
  .hero-orbit circle { stroke: none; fill: var(--brand); filter: drop-shadow(0 0 6px var(--brand)) }
  /* 点阵底：只在榫卯周围显出来，往四周淡掉 */
  .hero-grid {
    position: absolute; z-index: -1; pointer-events: none;
    top: 50%; right: -16rem; width: 52rem; height: 52rem; transform: translateY(-50%);
    background-image: radial-gradient(circle, var(--ring-strong) 1px, transparent 1.5px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(closest-side, #000 10%, transparent 78%);
    mask-image: radial-gradient(closest-side, #000 10%, transparent 78%);
  }
  .hero-glow-soft {
    position: absolute; z-index: -2; pointer-events: none;
    top: -14rem; left: -18rem; width: 44rem; height: 44rem;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--brand) 9%, transparent), transparent);
  }
  @media (max-width: 59.99rem) {
    .hero-rings, .hero-grid { right: 50%; top: 9rem; width: 34rem; height: 34rem; transform: translate(50%, -50%) }
  }

  .hero-copy { display: flex; flex-direction: column; gap: 1.4rem; min-width: 0 }
  .hero-copy > * { margin: 0 }
  .hero h1 {
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    font-weight: 750;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    animation: hero-in 0.7s 0.05s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-tagline {
    max-width: 33rem;
    font-size: clamp(1rem, 1.3vw, 1.075rem);
    line-height: 1.8;
    color: var(--sl-color-gray-3);
    animation: hero-in 0.7s 0.12s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* 标题里那几个字的流光（登录页「咬合」同款），只留这一处颜色 */
  .shine {
    background-image: linear-gradient(90deg, var(--brand) 0%, var(--brand-shine-mid) 35%, var(--brand-shine-hot) 50%, var(--brand-shine-mid) 65%, var(--brand) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: hero-shimmer 6s linear infinite;
  }

  .hero-stack { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; list-style: none; animation: hero-in 0.7s 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) both }
  .hero-stack li {
    display: inline-flex; align-items: center; gap: 0.45rem; margin: 0;
    height: 1.75rem; padding: 0 0.7rem; border-radius: 999px;
    font-size: 0.8rem; font-weight: 500; color: var(--sl-color-gray-2);
    background: color-mix(in oklab, var(--dot) 10%, transparent);
  }
  .hero-stack li::before { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 99px; background: var(--dot) }

  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; animation: hero-in 0.7s 0.24s cubic-bezier(0.2, 0.7, 0.2, 1) both }
  .hero-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    height: 2.75rem; padding: 0 1.25rem; border-radius: 0.6rem;
    font-weight: 600; font-size: 0.925rem; text-decoration: none;
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
  }
  .hero-btn:hover { transform: translateY(-1px) }
  .hero-btn--primary { color: var(--ink-fg); background: var(--ink); box-shadow: 0 8px 20px -12px oklch(0.17 0.02 280 / 0.6) }
  .hero-btn--primary:hover { color: var(--ink-fg) }
  .hero-btn--secondary { color: var(--sl-color-white); background: var(--surface-hi); box-shadow: inset 0 0 0 1px var(--line-strong) }
  .hero-btn--secondary:hover { color: var(--sl-color-white); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--brand) 45%, transparent) }
  .hero-btn--minimal { color: var(--sl-color-gray-2); padding-inline: 0.5rem }
  .hero-btn--minimal:hover { color: var(--brand) }

  .hero-stage { height: clamp(16rem, 32vw, 28rem); min-width: 0 }
  @media (max-width: 59.99rem) {
    .hero-stage { order: -1; height: 14rem; margin: -1.5rem 0 -1rem }
  }

  @keyframes hero-in { from { opacity: 0; transform: translateY(10px) } to { opacity: 1; transform: none } }
  @keyframes hero-shimmer { from { background-position: 200% 0 } to { background-position: -200% 0 } }
  @keyframes hero-spin { to { transform: rotate(360deg) } }
  @media (prefers-reduced-motion: reduce) {
    .hero *, .shine { animation: none !important }
  }

  /*
   * 首页往下滚时各块依次浮上来。隐藏态挂在 `.reveal-on` 上，而这个类是下面那段脚本加的 ——
   * 脚本没跑（禁用 JS、爬虫、减少动效）时内容就是直接可见的，不会有「等一个永远不来的动画」的空白页。
   */
  :root.reveal-on [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(var(--reveal-i, 0) * 70ms) }
  :root.reveal-on [data-reveal].is-in { opacity: 1; transform: none }
</style>

<script>
  // 只在首页跑（这个组件只出现在带 hero 的页面）。减少动效时整段不启用
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll<HTMLElement>(
      '.sl-markdown-content :is(.section-title, .showcase, .feature-line, .closing)',
    )
    const io = new IntersectionObserver((entries) => {
      // 同一批进入视口的（一排三个小功能）按先后错开一点
      entries.filter((e) => e.isIntersecting).forEach((entry, i) => {
        const el = entry.target as HTMLElement
        el.style.setProperty('--reveal-i', String(i))
        el.classList.add('is-in')
        io.unobserve(el)
      })
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 })
    targets.forEach((el) => { el.dataset.reveal = ''; io.observe(el) })
    document.documentElement.classList.add('reveal-on')
  }
</script>
