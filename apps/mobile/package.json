{
  "name": "@admin/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "移动端原生 App（issue #39 的 C 路线）：Expo Router + uniwind，交互逻辑独立于 web，不复用 PC 端渲染",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "start:clean": "expo start -c",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform android --output-dir dist",
    "lint": "eslint",
    "start:plain": "expo start",
    "native:prebuild": "expo prebuild --platform android --clean",
    "apk": "node scripts/apk.mjs"
  },
  "dependencies": {
    "@admin/api": "workspace:*",
    "@admin/i18n": "workspace:*",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.25",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.17",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8.67.0"
  }
}
