# E2E 测试专用环境 —— 复制成 backend/.env.e2e 后填真实密码即可（该文件已 gitignore）。
#
# 和 backend/.env 的三处关键差异，缺一个都会出问题：
#
#   1. DATABASE_SCHEMA 指向 fba_test 而不是 fba —— 这不是另开一个环境变量，
#      是复用 pytest 已经在用的那个库（backend/conftest.py 的 get_database_url(unittest=True)
#      本质上也是拼出 `{DATABASE_SCHEMA}_test`）。直接把这个字段设成 'fba_test'，
#      跑起来的 uvicorn 实例就会把它当成自己的主库，不会污染开发用的 fba。
#      建库/建表/灌种子的步骤见 CLAUDE.md「跑测试」——两者共用同一份 fba_test。
#
#   2. REDIS_DATABASE 换成一个 dev（0）和 celery（1）都没占用的号——
#      Redis 的 key 前缀是全局的（fba:user:<id> / fba:token:<uuid>），
#      而 fba_test 是从同一份种子脚本建出来的，admin 的雪花 ID 在两个库里**完全相同**
#      （实测确认过：2048601263834267648）。共用同一个 Redis DB 的话，E2E 一登录，
#      就会用 fba_test 的用户信息覆盖掉你本机 fba_redis 里 dev session 的缓存——
#      表现是「跑完一轮 E2E，自己在开发环境里的登录态莫名其妙变了」。
#
#   3. LOGIN_CAPTCHA_ENABLED=false
# 🔴 关掉限流。E2E 的 global-setup 走 `/auth/login/swagger` 拿 token，而整套用例
# 来自**同一个 IP**（限流 key 是 `{IP}:{path}`）—— 不关的话第 6 次登录就是 429，
# 表现是「E2E 环境准备失败」，看起来像环境没配好而不是被限流。
# pytest 侧同理，由 `backend/conftest.py` 的 `_disable_rate_limiter` 关掉。
# ⚠️ prod 下这个值为 false 会被 `check_production_settings()` 拒绝启动。
REQUEST_LIMITER_ENABLED=false
 —— 前端登录页本来就认这个开关
#      （sign-in.tsx 的 captchaState 有个 'off' 分支，is_enabled=false 时
#      直接不渲染验证码框），不用在测试代码里读 Redis 解验证码答案。
#
# 其余字段照抄 backend/.env（DB 主机/端口/密码、Redis 主机/端口/密码用的是
# 同一个 docker-compose.dev.yml 起的容器，本来就该一样）。

ENVIRONMENT='dev'

# Database —— 指向 fba_test，不是 fba
DATABASE_TYPE='sqlserver'
DATABASE_HOST='127.0.0.1'
DATABASE_PORT=1433
DATABASE_USER='sa'
DATABASE_PASSWORD='YourStrong!Passw0rd'
DATABASE_SOURCES='{}'
DATABASE_SCHEMA='fba_test'
DATABASE_PK_MODE='snowflake'
DATABASE_DRIVER='ODBC Driver 18 for SQL Server'
DATABASE_TRUST_SERVER_CERTIFICATE=true

# 雪花 ID（沿用开发环境同一套 worker 配置即可，E2E 不会和 dev 实例同时写同一条记录）
SNOWFLAKE_ENABLED=true
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

# Redis —— 换库号，避开 dev（0）和 celery（1），理由见文件头注释第 2 条
REDIS_HOST='127.0.0.1'
REDIS_PORT=6380
REDIS_PASSWORD=''
REDIS_DATABASE=2

# Token —— 随便一个值即可，E2E 不需要和 dev 用同一个签名密钥
TOKEN_SECRET_KEY='e2e-only-not-a-real-secret-CHANGE-ME'

# 登录验证码 —— 关掉，理由见文件头注释第 3 条
LOGIN_CAPTCHA_ENABLED=false

# CORS —— 只放 E2E 专用的前端端口（1126），不是 dev 的 1125。
# 这条不影响 dev 实例的白名单：dev 读的是另一份 .env。
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:1126","http://localhost:1126"]

# [ Plugin ] oauth2 / email —— E2E 不测这两块，随便填占位值即可（Settings 要求非空）
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
