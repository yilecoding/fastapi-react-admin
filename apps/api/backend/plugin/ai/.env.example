# [ Plugin ] ai
# 模型供应商 API Key 的落库加密密钥：32 字节 = 64 位十六进制。
# 生成：python -c "import os;print(os.urandom(32).hex())"
#
# ⚠️ 留空是**安全的默认**：「模型密钥管理」会拒绝保存并明确报错，
#    不会静默把密钥存成明文（plugin.toml 里的 "" 是兜底，这里的值会覆盖它）。
# ⚠️ 刻意和 TOKEN_SECRET_KEY 分开：token 密钥泄露和供应商密钥泄露是两类事故，
#    共用一把会让其中一次泄露的爆炸半径变成两倍。
AI_ENCRYPT_SECRET_KEY=''
