# Env
ENVIRONMENT='dev'
# Database
# 默认值与仓库根的 docker-compose.dev.yml 对齐 —— 起完容器直接就能连上。
# 换 SQL Server / MySQL 就改 DATABASE_TYPE 与端口（1433 / 3306）——
# 换 SQL Server 还要显式起那个 profile：
#   docker compose -f docker-compose.dev.yml --profile sqlserver up -d mssql
DATABASE_TYPE='postgresql'
DATABASE_HOST='127.0.0.1'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='postgres'
# ⚠️ 雪花主键。三种方言的种子数据都只提供了雪花版
# （backend/sql/{mysql,postgresql,sqlserver}/ 下都只有 init_snowflake_test_data.sql，
# 三份靠 backend/tests/test_seed_dialects.py 做结构一致性守卫），
# 用 autoincrement 的话 `fba init` 找不到对应的种子文件会**静默跳过**，
# 库建好了却没有 admin 账号。
DATABASE_PK_MODE='snowflake'
# 额外数据源
# DATABASE_SOURCES='{"read": "postgresql+asyncpg://user:password@host:5432/fba"}'
DATABASE_SOURCES='{}'
# Redis
REDIS_HOST='127.0.0.1'
# 6380 而不是默认 6379 —— 见 docker-compose.dev.yml 里的说明
REDIS_PORT=6380
REDIS_PASSWORD=''
REDIS_DATABASE=0
# Token
TOKEN_SECRET_KEY='CHANGE_ME__secrets.token_urlsafe(32)'
# 用户批量导入（POST /sys/users/import/*）
# 空串 = **关闭这个功能**，不是「用某个内置默认值」——内置值会跟着仓库一起公开，
# 而每套部署都会照抄。填了就是这批导入账号的统一初始密码。
# ⚠️ 它自己必须过密码强度校验（长度 / 含数字 / 含字母），`123456` 过不了。
#     不校验的失败是延迟且分裂的：导入成功、用户能登录，但他改密码时被
#     「必须包含字母」挡住，而两件事看不出是同一个原因。
# ⚠️ 刻意不放 sys_config（参数配置页）：那张表的值会原样显示在页面上，
#     且改它的请求体会进操作日志。
USER_IMPORT_DEFAULT_PASSWORD=''
# [ App ] task
# Celery
# broker 选哪个：'redis'（默认，开发依赖里已经有了）或 'rabbitmq'。
# 这是唯一决定点 —— 任何环境都读这里，不会被代码覆盖。
# 选 rabbitmq 要先起服务：
#   docker compose -f docker-compose.dev.yml --profile rabbitmq up -d
CELERY_BROKER='redis'
# broker 用 Redis 时占哪个库（dev 用 0、e2e 用 2，这里用 1 错开）
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq —— 只在 CELERY_BROKER='rabbitmq' 时生效
CELERY_RABBITMQ_HOST='127.0.0.1'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
