# 生产编排的配置模板 —— **复制成 .env.server 再改**，不要直接用。
#
#     cp .env.server.example .env.server
#     python -c "import secrets;print(secrets.token_urlsafe(32))"   # 生成签名密钥
#
# 🔴 这份文件里的 CHANGE_ME 占位符不是形式主义：`ENVIRONMENT='prod'` 时
# `backend/core/conf.py: check_production_settings()` 会逐项校验并**拒绝启动**，
# 而且不只查占位符 —— 长度、去重字符数、Shannon 熵三道闸一起看，
# 把 CHANGE_ME 改成 123 一样过不去。
#
# 历史教训：这份文件原来带着一个**写死的** TOKEN_SECRET_KEY 直接进仓库，
# 而 docker-compose.yml 有四处把它挂成容器里的 /fba/backend/.env ——
# 照这份编排部署的所有实例共用同一个 JWT 签名密钥。

# Env
ENVIRONMENT='prod'
# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='fba_postgres'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='CHANGE_ME__强口令，勿用示例值'
# 额外数据源
# DATABASE_SOURCES='{"read": "postgresql+asyncpg://user:password@host:5432/fba"}'
DATABASE_SOURCES='{}'
# Redis
REDIS_HOST='fba_redis'
REDIS_PORT=6379
REDIS_PASSWORD='CHANGE_ME__强口令，勿用示例值'
REDIS_DATABASE=0
# Token
TOKEN_SECRET_KEY='CHANGE_ME__secrets.token_urlsafe(32)'
# [ App ] task
# Celery
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq
CELERY_RABBITMQ_HOST='fba_rabbitmq'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
