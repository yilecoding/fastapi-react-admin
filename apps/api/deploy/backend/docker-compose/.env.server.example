# 生产编排的配置模板 —— **复制成 .env.server 再改**，不要直接用。
#
#     cp .env.server.example .env.server
#     python -c "import secrets;print(secrets.token_urlsafe(32))"   # 生成签名密钥
#     python -c "import secrets;print(secrets.token_hex(32))"       # 生成参数配置加密密钥
#
# 🔴 这份文件里的 CHANGE_ME 占位符不是形式主义：`ENVIRONMENT='prod'` 时
# `backend/core/conf.py: check_production_settings()` 会逐项校验并**拒绝启动**，
# 而且不只查占位符 —— 长度、去重字符数、Shannon 熵三道闸一起看，
# 把 CHANGE_ME 改成 123 一样过不去。
#
# 历史教训：这份文件原来带着一个**写死的** TOKEN_SECRET_KEY 直接进仓库，
# 而 docker-compose.yml 有四处把它挂成容器里的 /fba/backend/.env ——
# 照这份编排部署的所有实例共用同一个 JWT 签名密钥。

# Env
ENVIRONMENT='prod'
# Database (SQL Server is the production mainline; provision it outside this Compose file)
DATABASE_TYPE='sqlserver'
DATABASE_HOST='CHANGE_ME__sqlserver.example.internal'
DATABASE_PORT=1433
DATABASE_USER='CHANGE_ME__fba_app'
DATABASE_PASSWORD='CHANGE_ME__强口令，勿用示例值'
# SQL Server database name. Create it before starting the application.
DATABASE_SCHEMA='fba'
DATABASE_DRIVER='ODBC Driver 18 for SQL Server'
DATABASE_TRUST_SERVER_CERTIFICATE=true
# SQL Server seed data and IDs use snowflake mode.
DATABASE_PK_MODE='snowflake'
# 额外数据源
# DATABASE_SOURCES='{"read": "postgresql+asyncpg://user:password@host:5432/fba"}'
DATABASE_SOURCES='{}'
# 连接池（每个进程一份）。🔴 api 的 worker 数 × 每个进程（POOL_SIZE + POOL_MAX_OVERFLOW）
# 再加上 celery worker 的进程，总数不能超过数据库的 max_connections，否则高峰期报 too many clients。
# DATABASE_POOL_SIZE=10
# DATABASE_POOL_MAX_OVERFLOW=20
# 借连接前先探活，默认关（每个请求少几次往返）。关着时数据库重启 / 主从切换那一刻会有个别请求失败一次，
# 数据库经常切换、或者中间有掐空闲连接的防火墙时打开
# DATABASE_POOL_PRE_PING=false
# Redis（独立部署，不在 docker-compose.prod.yml 里；同机但跑在 Docker 外的话，
# 填宿主机地址不要填 127.0.0.1——容器里的回环地址连不到宿主机，见 compose 文件顶部注释）
REDIS_HOST='CHANGE_ME__redis.example.internal'
REDIS_PORT=6379
REDIS_PASSWORD='CHANGE_ME__强口令，勿用示例值'
REDIS_DATABASE=0
# Token
TOKEN_SECRET_KEY='CHANGE_ME__secrets.token_urlsafe(32)'
# HTTPS 生产站点显式开启；即使 TLS 在上游终结，也始终给 refresh / OAuth2 cookie 加 Secure。
# 仅明文 HTTP 的部署才设 false，否则浏览器不会回传 cookie，登录无法续期。
COOKIE_SECURE=true
# Public web origin and the Docker/LB proxy network. Replace both for your topology.
# 发桌面端安装包时追加 "app://local"（桌面端渲染层的源）：这里会整个覆盖 conf.py 的默认列表，
# 漏了的表现是桌面端填好服务器地址后所有接口 CORS 失败，和后端挂了长得一样（#392）。
CORS_ALLOWED_ORIGINS='["https://admin.example.com"]'
TRUSTED_PROXIES='["172.16.0.0/12"]'
# prod validation requires at least 8 characters for newly changed passwords.
USER_PASSWORD_MIN_LENGTH=8
# 登录图形验证码，**按参数走，prod 不强制开**（#410）。这里的值只是启动时的默认值：
#   运行时以「系统管理 → 参数配置 → 登录策略」里保存的值为准，会覆盖这里；
#   超级管理员可以在那里随时开关，改完立即生效，不用重启。
#   关掉之后登录爆破还有 REQUEST_LIMITER_ENABLED 的限流和账号 / IP 锁定兜着（限流在 prod 不许关）。
# LOGIN_CAPTCHA_ENABLED=true
# [ App ] task
# Celery
CELERY_BROKER='redis'
CELERY_BROKER_REDIS_DATABASE=1
# Rabbitmq
CELERY_RABBITMQ_HOST='fba_rabbitmq'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='guest'
CELERY_RABBITMQ_PASSWORD='guest'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
# 数据变更记录签名链的密钥（HMAC-SHA256）。留空时谁都能重算签名，只防手工改库；
# 配了之后和数据库分开保管，🔴 设了就别换（换了旧记录会被单独列成「换密钥之前签的」）。
# 生成：python -c "import os;print(os.urandom(32).hex())"
DATA_CHANGE_CHAIN_KEY=''
# [ Plugin ] config
# 参数配置里密钥类的值（SMTP 授权码 EMAIL_PASSWORD，以及键名以 PASSWORD / SECRET / TOKEN /
# API_KEY 等结尾的配置）落库加密用。**用到才配**：留空时，保存这类值会明确报错，不会存明文。
# 16/24/32 字节的十六进制：python -c "import secrets;print(secrets.token_hex(32))"
# 🔴 从 1.1.0 升级：库里已经存过这类值时，必须先配，否则迁移中止、新版 api 起不来。
#    api / migrate / worker / beat 都挂这同一份文件，配一处就够。
# 🔴 配了就妥善备份、不要再换 —— 换了或丢了，库里已有的密文就解不开了。
CONFIG_ENCRYPT_SECRET_KEY=''
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
