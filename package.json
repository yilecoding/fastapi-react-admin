{
  "name": "fastapi-react-admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@admin/desktop",
    "desktop:dev": "pnpm --filter @admin/desktop dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "i18n:check": "pnpm --filter @admin/i18n check",
    "i18n:fix": "pnpm --filter @admin/i18n check:fix",
    "i18n:jsx": "pnpm --filter @admin/i18n jsx",
    "ctx:check": "node scripts/ctx-check.mjs",
    "db:upgrade": "pnpm --filter api db:upgrade",
    "db:revision": "pnpm --filter api db:revision",
    "db:current": "pnpm --filter api db:current",
    "db:history": "pnpm --filter api db:history",
    "db:init": "pnpm --filter api db:init",
    "db:reset": "pnpm --filter api db:reset",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "e2e:install": "pnpm --filter web exec playwright install chromium",
    "install:all": "pnpm install && pnpm --filter api exec uv sync --group dev && pnpm e2e:install"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "~6"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  }
}
