    "test": "turbo test"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "~6"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  }
}
