# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# env files (can opt-in for committing if needed)
.env*
# 但 .env.example 要提交：它既是 `fba init` 消费的模板，
# 也是「需要配哪些变量」的唯一清单，不带上别人 clone 下来无从下手
!apps/api/backend/.env.example
# 插件各自的模板同理 —— 漏掉的话 email / oauth2 插件在新环境里没有可抄的样板
!apps/api/backend/plugin/*/.env.example
# E2E 隔离环境同理，见 apps/web/e2e/ 和 CLAUDE.md「E2E 测试」
!apps/api/backend/.env.e2e.example
# 部署编排的模板同理 —— docker-compose.yml 有四处挂载 .env.server，
# 而它是 gitignore 的：不提交一份模板，别人 clone 下来那四处挂载全是空的
!apps/api/deploy/backend/docker-compose/.env.server.example

# turbo
.turbo

# TanStack Router 插件的临时目录（UUID 命名的中间产物）。
# 注意：src/routeTree.gen.ts 是**要提交**的生成物，别一起忽略掉 ——
# 它是编译期路由表，缺了它 CI 上第一次构建会找不到路由。
.tanstack/

# Editor directories and files
.vscode/*
!.vscode/extensions.json

# Claude Code：.claude/ 下默认全忽略，只放行团队共享的「能力」（技能 / 子代理 / 命令）。
# 其余都是本机的东西：settings.local.json（个人权限）、launch.json（本机起 dev server
# 的配置）、worktrees/（会话开的工作树，整份仓库的副本）……
# 用白名单而不是逐个列黑名单：Claude Code 会往这里写新的本地文件，worktrees/ 和
# launch.json 都是这样冒出来的；之前不进仓库全靠个人的全局 gitignore 和
# .git/info/exclude 兜着，换台机器 `git add .` 就带进去了。
# 要共享项目级设置时再放行 settings.json —— 那是 Claude Code 约定的共享配置，
# settings.local.json 才是个人的。
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# typescript
*.tsbuildinfo

# 上传文件（运行时数据，不进仓库）
apps/api/backend/upload/

# @file-viewer 开发期拷贝的 wasm/worker 资产（由 vite 插件生成）
apps/web/public/file-viewer/

# Electron 打包产物
apps/desktop/release/

# 原生助手程序及其厂商 DLL（体积大、且多数有授权限制，不进仓库；
# 由 Build 流程或人工放进去，见 apps/desktop/README.md）
apps/desktop/resources/*
!apps/desktop/resources/.gitkeep

# 公开上传子树（运行时数据，被 /uploads 静态挂出去）
apps/api/backend/upload-public/

# Playwright（E2E）。⚠️ 路径不是 apps/web/e2e/test-results —— config 在
# apps/web/e2e/playwright.config.ts，但 `pnpm --filter web e2e` 是从 apps/web/
# 起（cwd=apps/web），Playwright 的默认 outputDir 跟着 cwd 走，实测落在
# apps/web/test-results/。这条写错过一次：目录名对得上直觉，但没匹配到
# 真实产物路径，1.4MB 的 trace/截图/zip 差点被 git add 进去
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
