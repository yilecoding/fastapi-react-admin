{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@admin/api-contract": ["../api-contract/src/index.ts"],
      "@admin/api-contract/schema": ["../api-contract/src/schema.d.ts"],
      "@admin/i18n": ["../i18n/src/index.ts"],
      "@platform/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
